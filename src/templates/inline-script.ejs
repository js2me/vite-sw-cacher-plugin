(() => {
  if (!("serviceWorker" in navigator)) return;
  window.addEventListener("load", () => {
    <% if (inlineSw) { %>
    const swCode = <%- swCodeJson %>;
    const blob = new Blob([swCode], { type: "text/javascript" });
    const swUrl = URL.createObjectURL(blob);
    navigator.serviceWorker
      .register(swUrl)
      .catch((error) => {
        console.warn("[vite-sw-cacher-plugin] SW registration failed", error);
      })
      .finally(() => {
        URL.revokeObjectURL(swUrl);
      });
    <% } else { %>
    navigator.serviceWorker
      .register(<%- swUrlJson %>)
      .catch((error) => {
        console.warn("[vite-sw-cacher-plugin] SW registration failed", error);
      });
    <% } %>

    <% if (lazyPreload) { %>
    const assets = <%- assetsJson %>;
    const MAX_CONCURRENT = <%- lazyPreloadConcurrency %>;
    const BATCH_DELAY_MS = <%- lazyPreloadBatchDelayMs %>;
    let index = 0;
    let inFlight = 0;

    const schedulePump = () => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(pump);
      } else {
        setTimeout(pump, BATCH_DELAY_MS);
      }
    };

    const pump = () => {
      while (inFlight < MAX_CONCURRENT && index < assets.length) {
        const url = assets[index++];
        inFlight += 1;
        fetch(url, { credentials: "same-origin" })
          .catch(() => undefined)
          .finally(() => {
            inFlight -= 1;
            if (index < assets.length) {
              schedulePump();
            }
          });
      }
    };
    const runWhenIdle = () => {
      schedulePump();
    };
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const isGoodNetwork = (conn) => {
      if (!conn) return false;
      if (conn.saveData) return false;
      if (typeof conn.downlink === "number" && conn.downlink < 0.8) return false;
      if (typeof conn.rtt === "number" && conn.rtt > 350) return false;
      if (typeof conn.effectiveType === "string" && !["4g", "3g"].includes(conn.effectiveType)) return false;
      return true;
    };
    if (connection && typeof connection.addEventListener === "function") {
      if (isGoodNetwork(connection)) {
        runWhenIdle();
      } else {
        const onChange = () => {
          if (isGoodNetwork(connection)) {
            connection.removeEventListener("change", onChange);
            runWhenIdle();
          }
        };
        connection.addEventListener("change", onChange);
        setTimeout(() => {
          connection.removeEventListener("change", onChange);
          runWhenIdle();
        }, 10000);
      }
    } else {
      runWhenIdle();
    }
    <% } %>
  });
})();
